{
  "name": "@sompaykit/demo",
  "version": "0.0.1",
  "private": true,
  "description": "Demo shop for SomPayKit (manual mode, no real money). Static pages + a Cloudflare Pages Function for /api.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev-api.ts",
    "build": "next build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@sompaykit/core": "workspace:^",
    "@sompaykit/react": "workspace:^",
    "clsx": "2.1.1",
    "next": "15.5.29",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@sompaykit/registry": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
