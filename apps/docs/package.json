{
  "name": "@sompaykit/docs",
  "version": "0.0.0",
  "private": true,
  "description": "sompaykit.dev: docs and the free shadcn registry (/r/*.json). Static export for Cloudflare Pages.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-registry.mjs && next dev",
    "build": "node scripts/copy-registry.mjs && next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "fumadocs-mdx && tsc -p tsconfig.json --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@sompaykit/core": "workspace:^",
    "@sompaykit/react": "workspace:^",
    "clsx": "2.1.1",
    "fumadocs-core": "15.8.5",
    "fumadocs-mdx": "12.0.3",
    "fumadocs-ui": "15.8.5",
    "next": "15.5.29",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@sompaykit/registry": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
