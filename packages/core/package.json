{
  "name": "@sompaykit/core",
  "version": "0.0.0",
  "description": "Accept EVC Plus, Zaad, Sahal and eDahab in any TypeScript app. Zero dependencies, fetch only.",
  "license": "MIT",
  "author": "Aoub (https://aoubak.com)",
  "keywords": [
    "somalia",
    "payments",
    "evc-plus",
    "zaad",
    "sahal",
    "edahab",
    "waafipay",
    "mobile-money"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
